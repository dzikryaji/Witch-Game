  stableId: order.simple.c06
  difficulty: 0
  orderBubbles:
  - "Excuse me."
  - "My younger brother has a high fever, swollen hands,"
  - "and tremors violent enough to spoil every line he writes."
  - "He drinks plenty, has sound kidneys,"
  - "and his heart is young and strong."
  - "A physician's margin note prescribes Sambucus nigra for the fever"
  - "and Hyoscyamus niger for the fits."
  - "Please prepare those two."
  - "The parish can survive one day without his handwriting."
  firstHerbId: herb.elderflower
  secondHerbId: herb.henbane
