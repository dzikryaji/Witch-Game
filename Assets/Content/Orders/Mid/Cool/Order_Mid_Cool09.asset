  m_Script: {fileID: 11500000, guid: f5f76fe6c3f7d450e98c5e1ef5f66046, type: 3}
  m_Name: Order_Mid_Cool09
  m_EditorClassIdentifier: Witch.Infrastructure::Witch.Infrastructure.Content.OrderDefinition
  stableId: order.mid.c09
  difficulty: 1
  orderBubbles:
  - A fellow courier was thrown into thorn scrub.
  - Her muscles ache, and one thorn cut has turned hot.
  - She breathes strongly, has no asthma,
  - and is warm beneath two blankets.
  - A road surgeon recommended Salix alba for the pain
  - and Borago officinalis to slow the infection.
  - Prepare both.
  - The post can wait longer than her blood can.
  firstHerbId: herb.whiteWillow
  secondHerbId: herb.borage
